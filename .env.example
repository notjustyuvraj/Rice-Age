# Copy to .env before running. Change every secret for production.
ENVIRONMENT=development
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DATABASE_URL=postgresql+psycopg://riceage:riceage_dev_password@localhost:5432/rice_age
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
DEVICE_TOKEN_MINUTES=15
STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=15728640
CORS_ORIGINS=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-Immediately-123!
REQUIRE_ALL_ATTACHMENTS=true
